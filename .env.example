# ==============================================================================
# CinePlus - Variables de Entorno de Ejemplo
# Copia este archivo como .env.local y completa tus claves reales
# ==============================================================================

# API de The Movie Database (TMDb v3)
# Obtén tu clave gratuita en: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Backend como Servicio (Supabase)
# Copia estos valores desde: Project Settings > API en https://supabase.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Maps Platform (Opcional - si se deja vacío, la app usa el Modo Demo automático)
VITE_GOOGLE_MAPS_API_KEY=

# Telegram Bot (2FA / OTP y Alertas de Seguridad)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_BOT_USERNAME=CinePlusSeguridad_bot

# Google Gemini API (Para LLM - Agente Crítico de Arte)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# OpenRouter API (Para DeepSeek / Qwen / LLaMA - Agente Financiero de Cines)
# Obtén tu clave en: https://openrouter.ai/keys (soporta modelos :free gratuitos)
VITE_OPENROUTER_API_KEY=

# xAI Grok API (Para Agente Moderador y Juez Supremo)
# Obtén tu clave en: https://console.x.ai/ (O usa OpenRouter con x-ai/grok-2)
VITE_GROK_API_KEY=


